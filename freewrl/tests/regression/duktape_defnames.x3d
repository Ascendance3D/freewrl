<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 3.3//EN" "http://www.web3d.org/specifications/x3d-3.3.dtd">
<X3D profile='Interchange' version='3.3'>
  <head>
    <meta name='description' content='Functional smoke test (duktape): a Script initialize() gets Browser.currentScene (an X3DExecutionContext), creates six Group nodes with ec.createNode, and registers each with ec.updateNamedNode, then confirms every name resolves with ec.getNamedNode before emitting the success marker (so the marker actually validates the append result, not just that the calls returned). This exercises the SAI createNode + updateNamedNode + getNamedNode append path end to end. Pass: DUK_DEFNAMES_START, DUK_DEFNAMES_UPDATE_1..6, DUK_DEFNAMES_VERIFIED count=6 and DUK_DEFNAMES_DONE all print, with no crash and no AddressSanitizer report. NOTE: this is NOT a memory-safety regression guard. updateNamedNode has a latent DEF-name Vector element-size bug (it lazily creates the list with newVector(struct brotoDefpair*,4) instead of struct brotoDefpair), but createNewX3DNode always pre-creates a correctly-sized __DEFnames via add_empty_proto_vectors before any script runs, so the buggy branch is not reachable from script and this fixture passes with and without the fix.'/>
  </head>
  <Scene>
    <Background skyColor='0.1 0.1 0.2'/>
    <Viewpoint position='0 0 6' description='front'/>
    <Shape>
      <Appearance><Material diffuseColor='0 1 0'/></Appearance>
      <Box size='1.5 1.5 1.5'/>
    </Shape>
    <Script>
<![CDATA[javascript:
function initialize() {
	print('DUK_DEFNAMES_START');
	var ec = Browser.currentScene;
	for (var i = 1; i <= 6; i++) {
		var n = ec.createNode('Group');
		ec.updateNamedNode('defname_' + i, n);
		print('DUK_DEFNAMES_UPDATE_' + i);
	}
	// verify each mapping was actually added: getNamedNode must resolve every name
	var verified = 0;
	for (var j = 1; j <= 6; j++) {
		var g = null;
		try { g = ec.getNamedNode('defname_' + j); } catch (e) { g = null; }
		if (g) verified = verified + 1;
	}
	print('DUK_DEFNAMES_VERIFIED count=' + verified);
	if (verified == 6) print('DUK_DEFNAMES_DONE');
	else print('DUK_DEFNAMES_FAIL only ' + verified + ' of 6 resolved');
}
]]>
    </Script>
  </Scene>
</X3D>
