#!/bin/sh
#
#
# Clean all autotools files
# Clean all Makefiles
# Clean all *~ files
# Clean all generated files

rm -rf aclocal.m4 configure config.status config.log config.h config.h.in libtool stamp-h1 autom4te.cache config m4/lt* m4/libtool.m4 INSTALL doc/doxyfile

# Delete only the Makefile.in files that automake generates from a Makefile.am.
# src/libnurbs/Makefile.in and src/libtess/Makefile.in are hand-written sources.
find . -name Makefile.in -exec sh -c 'test -f "${1%.in}.am" && rm -f "$1"' sh {} \;

find . -name Makefile ! -path "*libtess/Makefile*" -delete

find . -name "*~" -delete

rm -f vtempl

rm -f build-stamp configure-stamp debian/files debian/freewrl.debhelper.log
rm -rf debian/freewrl
